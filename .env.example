# ─────────────── Telegram ───────────────
# Токен бота от @BotFather
BOT_TOKEN=123456:AAF...

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# ─────────────── Remnawave ───────────────
# URL панели (без / в конце).
# Если бот запускается НА ТОМ ЖЕ ХОСТЕ, что и панель — укажите контейнер напрямую:
#   REMNAWAVE_PANEL_URL=http://remnawave:3000
# (и раскомментируйте REMNAWAVE_DOCKER_NETWORK / COMPOSE_FILE в конце файла,
#  подробности — в README, раздел «Деплой на хост с Remnawave»)
REMNAWAVE_PANEL_URL=https://panel.example.com
# API-токен: панель → Настройки → API Tokens
REMNAWAVE_API_TOKEN=eyJhbGciOi...
# Префикс API (по умолчанию /api, менять не нужно)
REMNAWAVE_API_PREFIX=/api

# ВАЖНО: UUID Internal Squad, который выдавать покупателям.
# Панель → Управление → Internal Squads → скопировать UUID.
# Если оставить пустым — бот возьмёт первый попавшийся squad (и предупредит).
REMNAWAVE_SQUAD_UUID=

# Домен страницы подписок (напр. https://sub.example.com).
# Если пусто — бот возьмёт ссылку из ответа панели (subscriptionUrl).
SUB_PAGE_DOMAIN=

# Сбрасывать счётчик трафика при продлении подписки
RESET_TRAFFIC_ON_RENEW=true

# ─────────────── Оплата ───────────────
# CryptoBot (Crypto Pay API): @CryptoBot → Crypto Pay → Create App → API Token
CRYPTOBOT_TOKEN=
# Тестнет CryptoBot для отладки: true/false
CRYPTOBOT_TESTNET=false

# ЮKassa: shopId + секретный ключ (https://yookassa.ru → Настройки → Магазин)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

# Telegram Stars включаются автоматически, если у тарифа задана цена в звёздах.

# ─────────────── Тарифы ───────────────
# JSON со списком тарифов. Цены: price_rub (ЮKassa), price_stars (Telegram Stars),
# price_usdt (CryptoBot). Не нужный способ оплаты можно отключить, поставив null.
TARIFFS={"basic":{"title":"Подписка на 30 дней","days":30,"price_rub":199,"price_stars":150,"price_usdt":1.99,"description":"Все локации • безлимитный трафик • до 3 устройств"}}

# ─────────────── Прочее ───────────────
# Файл базы данных бота
DB_PATH=data/bot.db
# Часовой пояс для отображения дат (IANA name)
TZ=Europe/Moscow
# Ссылка на поддержку (кнопка в меню). Оставьте пустым, чтобы скрыть кнопку.
SUPPORT_URL=https://t.me/your_support

# ─────────────── Docker: деплой на хосте с Remnawave ───────────────
# Эти переменные читает docker compose (а не сам бот).
# Раскомментируйте обе строки, если бот ставится рядом с панелью:
#COMPOSE_FILE=docker-compose.yml:docker-compose.remna.yml
#REMNAWAVE_DOCKER_NETWORK=remnawave_network
